# Server port
PORT=4000

# Optional: point at a real PostgreSQL instance. When unset, an embedded PGlite
# database is created in .data/pglite.
# DATABASE_URL=postgres://user:password@localhost:5432/germaninminutes

# Optional: set to 1 when serving over HTTPS so session cookies are Secure.
# COOKIE_SECURE=1

# Public site URL used in password-reset links.
APP_URL=http://localhost:5173
